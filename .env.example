# --- Admin auth (server-only, never exposed to the browser) ---
ADMIN_USERNAME=
# Generate with: node scripts/hash-admin-password.mjs "your-password"
ADMIN_PASSWORD_HASH=
# 32+ random hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- MySQL / MariaDB (Hostinger) ---
# On Hostinger the app runs on the same server as the database: DB_HOST=localhost.
# Local dev: open a tunnel with `ssh -N -L 3307:127.0.0.1:3306 hostinger`,
# then use DB_HOST=127.0.0.1 and DB_PORT=3307.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Canonical site URL for sitemap/robots/metadata (defaults to https://lumiflick.shop)
NEXT_PUBLIC_SITE_URL=
