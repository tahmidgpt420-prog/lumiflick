# Firebase (public — safe to expose, security comes from firestore.rules + Auth, not secrecy)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Admin auth (server-only, never exposed to the browser) ---
ADMIN_USERNAME=
# Generate with: node scripts/hash-admin-password.mjs "your-password"
ADMIN_PASSWORD_HASH=
# 32+ random hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Dedicated Firebase Auth identity used ONLY by the server to write to Firestore ---
# Requires Firebase Console → Authentication → Sign-in method → Email/Password enabled first,
# then run: node --env-file=.env.local scripts/create-firebase-admin-user.mjs
ADMIN_FIREBASE_EMAIL=
ADMIN_FIREBASE_PASSWORD=
